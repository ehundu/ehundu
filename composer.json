{
    "name": "ehundu/ehundu",
    "description": "Generador de sitios estáticos en PHP, pensado para compilar también dentro de un proceso web.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ssg",
        "static-site-generator",
        "generador-de-sitios-estaticos",
        "markdown",
        "twig",
        "php",
        "español"
    ],
    "homepage": "https://ehundu.com",
    "authors": [
        {
            "name": "Paigar",
            "homepage": "https://www.paigar.eu"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "league/commonmark": "^2.10",
        "phpseclib/phpseclib": "^3.0",
        "symfony/yaml": "^8.0",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "ext-ftp": "Para desplegar por FTP o FTPS (destino: ftp)"
    },
    "autoload": {
        "psr-4": {
            "Ehundu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ehundu\\Pruebas\\": "pruebas/"
        }
    },
    "bin": [
        "bin/ehundu"
    ],
    "scripts": {
        "pruebas": "phpunit",
        "phar": "@php -d phar.readonly=0 herramientas/construir-phar.php"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
