{
    "name": "ehundu/ehundu",
    "description": "Generador de sitios estáticos en PHP, pensado para compilar también dentro de un proceso web.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "ssg",
        "static-site-generator",
        "generador-de-sitios-estaticos",
        "markdown",
        "twig",
        "php",
        "español"
    ],
    "homepage": "https://ehundu.com",
    "authors": [
        {
            "name": "Idenautas",
            "homepage": "https://idenautas.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "league/commonmark": "^2.10",
        "symfony/yaml": "^8.0",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Ehundu\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ehundu\\Pruebas\\": "pruebas/"
        }
    },
    "bin": [
        "bin/ehundu"
    ],
    "scripts": {
        "pruebas": "phpunit"
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    }
}
