<figure>{% if enlace %}<a href="{{ enlace }}"{% if externo %} target="_blank" rel="{{ rel }}"{% endif %}>{% endif %}{% if fuentes %}<picture>{% for fuente in fuentes %}<source type="{{ fuente.tipo }}" srcset="{{ fuente.srcset }}" sizes="{{ sizes }}">{% endfor %}{% endif %}<img src="{{ src }}"{% if srcset %} srcset="{{ srcset }}" sizes="{{ sizes }}"{% endif %} alt="{{ alt }}"{% if ancho and alto %} width="{{ ancho }}" height="{{ alto }}"{% endif %}>{% if fuentes %}</picture>{% endif %}{% if enlace %}</a>{% endif %}{% if pie %}<figcaption>{{ pie }}</figcaption>{% endif %}</figure>
