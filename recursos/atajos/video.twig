{% if insercion %}<div class="video" style="aspect-ratio: {{ proporcion }}"><iframe src="{{ insercion }}" title="{{ titulo }}" style="width: 100%; height: 100%; border: 0" loading="lazy" allow="autoplay; encrypted-media; fullscreen; picture-in-picture" allowfullscreen></iframe></div>{% else %}<video src="{{ src }}" title="{{ titulo }}" style="width: 100%; aspect-ratio: {{ proporcion }}" controls preload="metadata"></video>{% endif %}
